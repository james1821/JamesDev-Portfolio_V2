# ─── Public Firebase web config ──────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app.
# These are safe to expose; Security Rules do the enforcing, not secrecy.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# ─── Server-only service account ─────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private
# key. Copy the three values out of the downloaded JSON. NEVER commit these.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes and the literal \n escapes exactly as they appear
# in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ─── AI assistant ────────────────────────────────────────────────────────────
# Free key, no card required: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Leave empty to use the built-in free-model fallback chain.
OPENROUTER_MODEL=
ASSISTANT_QUESTION_LIMIT=5

# ─── Site ────────────────────────────────────────────────────────────────────
# Used for canonical URLs, structured data and the OpenRouter referer header.
SITE_URL=https://your-domain.com
