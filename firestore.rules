    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /experience/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /skills/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /currentWork/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /certifications/{id} { allow read: if true; allow write: if isAdmin(); }

    // Assistant quotas are written only by the server via the Admin SDK. No
    // client may read or touch them, so a visitor cannot reset their own count.
    match /rateLimits/{id}      { allow read, write: if false; }
    match /rateLimitsByIp/{id}  { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
