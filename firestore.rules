rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The admin claim. Anyone signed in may create it, but ONLY while it does
    // not already exist — so the first Google account to reach the dashboard
    // owns the site permanently. It can never be updated or deleted from the
    // client, which is what makes "sole admin" hold.
    match /config/admin {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/config/admin)
             && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }

    // Public content. The site reads it server-side with the Admin SDK, which
    // bypasses rules; these reads are for the dashboard's live listeners.
    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /experience/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /skills/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /currentWork/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /certifications/{id} { allow read: if true; allow write: if isAdmin(); }

    // Assistant quotas are written only by the server via the Admin SDK. No
    // client may read or touch them, so a visitor cannot reset their own count.
    match /rateLimits/{id}      { allow read, write: if false; }
    match /rateLimitsByIp/{id}  { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
